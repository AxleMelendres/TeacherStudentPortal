@model TeacherPortal.Models.Student
@{
    ViewData["Title"] = "Student Details";
    var subjects = (List<TeacherPortal.Models.StudentSubject>)ViewBag.Subjects;
}

<div class="section-head">
  <div>
    <h2>@Model.FullName</h2>
    <div class="sub">Student profile, contact information, and enrolled subjects.</div>
  </div>
  <div class="form-actions" style="margin-top:0;">
    <a class="btn btn-outline" asp-action="Index">Back</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.StudentId">Edit Student</a>
  </div>
</div>

<div class="student-detail-layout">
  <aside class="student-profile-card">
    <div class="student-profile-avatar">@GetInitials(Model.FullName)</div>
    <h3>@Model.FullName</h3>
    <p>@Model.StudentNumber</p>
    <span class="badge @(Model.Section == null ? "badge-gray" : "badge-blue")">@(Model.Section?.SectionName ?? "Unassigned")</span>
  </aside>

  <section class="student-detail-main">
    <div class="panel">
      <div class="panel-head"><h3>Student Information</h3></div>
      <div class="panel-body student-detail-grid">
        <div><span>Student Number</span><strong>@Model.StudentNumber</strong></div>
        <div><span>Email</span><strong>@Model.Email</strong></div>
        <div><span>Contact</span><strong>@(Model.ContactNumber ?? "-")</strong></div>
        <div><span>Section</span><strong>@(Model.Section?.SectionName ?? "Unassigned")</strong></div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3>Enrolled Subjects</h3>
        <span class="profile-panel-note">@subjects.Count subject records</span>
      </div>
      <div class="panel-body">
        @if (subjects.Any())
        {
          <div class="student-subject-list">
            @foreach (var subjectRow in subjects)
            {
              <div class="student-subject-item">
                <div>
                  <strong>@subjectRow.Subject?.SubjectCode</strong>
                  <span>@subjectRow.Subject?.SubjectName</span>
                </div>
                <small>@(subjectRow.Subject?.Room ?? "No room")</small>
              </div>
            }
          </div>
        }
        else
        {
          <div class="empty compact-empty">No subjects assigned yet.</div>
        }
      </div>
    </div>
  </section>
</div>

@functions {
    private static string GetInitials(string name)
    {
        var parts = (name ?? "Student").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", parts.Take(2).Select(part => part[0])).ToUpperInvariant();
    }
}
