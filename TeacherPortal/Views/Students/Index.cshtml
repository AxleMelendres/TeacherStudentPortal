@model IEnumerable<TeacherPortal.Models.Student>
@{
    ViewData["Title"] = "Students";
    var students = Model.ToList();
    var assignedCount = students.Count(s => s.SectionId.HasValue);
    var unassignedCount = students.Count - assignedCount;
}

<div class="section-head">
  <div>
    <h2>Students</h2>
    <div class="sub">Manage student records, section assignments, and account access.</div>
  </div>
  <div class="form-actions" style="margin-top:0;">
    <a asp-action="AddRegistered" class="btn btn-outline">Add Registered Student</a>
    <a asp-action="Create" class="btn btn-primary">+ Add Student</a>
  </div>
</div>

@if (TempData["msg"] is string message)
{
  <div class="alert alert-info">@message</div>
}

<div class="student-overview">
  <div class="section-metric">
    <span>Total Students</span>
    <strong>@students.Count</strong>
  </div>
  <div class="section-metric">
    <span>Assigned to Sections</span>
    <strong>@assignedCount</strong>
  </div>
  <div class="section-metric">
    <span>Unassigned</span>
    <strong>@unassignedCount</strong>
  </div>
</div>

<form method="get" class="student-filter-panel">
  <input class="form-control" type="text" name="q" value="@ViewBag.Query" placeholder="Search by name, student number, or email" />
  <select name="sectionId" class="form-control" asp-items="ViewBag.Sections"><option value="">All sections</option></select>
  <select name="subjectId" class="form-control" asp-items="ViewBag.Subjects"><option value="">All subjects</option></select>
  <button class="btn btn-secondary">Filter</button>
  <a class="btn btn-outline" asp-action="Index">Reset</a>
</form>

<div class="panel">
  <div class="panel-head">
    <h3>Student Directory</h3>
    <span class="profile-panel-note">@students.Count records shown</span>
  </div>
  <div class="panel-body" style="padding:0;">
    @if (!students.Any())
    {
      <div class="empty"><div class="ico">[]</div>No students found.</div>
    }
    else
    {
      <div class="student-table-wrap">
        <table class="table student-table">
          <thead>
            <tr>
              <th>Student</th>
              <th>Email</th>
              <th>Section</th>
              <th>Contact</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var student in students)
            {
              <tr>
                <td>
                  <div class="student-identity">
                    <span>@GetInitials(student.FullName)</span>
                    <div>
                      <strong>@student.FullName</strong>
                      <small>@student.StudentNumber</small>
                    </div>
                  </div>
                </td>
                <td>@student.Email</td>
                <td>
                  @if (student.Section == null)
                  {
                    <span class="badge badge-gray">Unassigned</span>
                  }
                  else
                  {
                    <span class="badge badge-blue">@student.Section.SectionName</span>
                  }
                </td>
                <td>@(student.ContactNumber ?? "-")</td>
                <td class="actions">
                  <a asp-action="Details" asp-route-id="@student.StudentId">View</a>
                  <a asp-action="Edit" asp-route-id="@student.StudentId">Edit</a>
                  <a asp-action="Delete" asp-route-id="@student.StudentId" style="color:var(--color-primary)">Delete</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

@functions {
    private static string GetInitials(string name)
    {
        var parts = (name ?? "Student").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", parts.Take(2).Select(part => part[0])).ToUpperInvariant();
    }
}
