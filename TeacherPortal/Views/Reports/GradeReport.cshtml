@model IEnumerable<TeacherPortal.Models.Grade>
@{ ViewData["Title"]="Grade Report"; }
<div class="section-head"><div><h2>Grade Report</h2><div class="sub">All recorded final grades</div></div></div>
<div class="panel"><div class="panel-body" style="padding:0;">
<table class="table"><thead><tr><th>Student</th><th>Subject</th><th>Final Grade</th><th>Remarks</th></tr></thead><tbody>
@foreach(var g in Model){var cls = g.Remarks=="Passed"?"badge-green":"badge-red";
<tr><td>@g.Student?.FullName</td><td>@g.Subject?.SubjectCode — @g.Subject?.SubjectName</td><td><strong>@g.FinalGrade</strong></td><td><span class="badge @cls">@g.Remarks</span></td></tr>}
</tbody></table></div></div>
