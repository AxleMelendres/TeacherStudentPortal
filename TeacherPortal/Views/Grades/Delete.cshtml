@model TeacherPortal.Models.Grade
@{ ViewData["Title"]="Delete Grade"; }
<div class="section-head"><h2>Delete grade?</h2></div>
<div class="form-card"><p>@Model.Student?.FullName — @Model.Subject?.SubjectCode (@Model.FinalGrade)</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="GradeId"/>
<div class="form-actions"><button class="btn btn-primary">Delete</button><a class="btn btn-outline" asp-action="Index">Cancel</a></div>
</form></div>
