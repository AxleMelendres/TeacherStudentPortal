@model TeacherPortal.Models.ViewModels.GradeIndexViewModel
@{
    ViewData["Title"] = "Grades";
    var period   = ViewBag.Period as string ?? "Midterm";
    var periods  = ViewBag.Periods as string[] ?? new[] { "Midterm", "Finals" };
    var types    = ViewBag.Types as string[]   ?? new[] { "Activity", "Quiz", "Exam", "Project" };
    var cols     = Model.Columns.Where(c => c.Period == period).ToList();
    var weight   = period == "Midterm" ? Model.MidtermWeight : Model.FinalsWeight;
}

<div class="section-head">
    <div>
        <h2>@Model.Subject.SubjectCode — @Model.Subject.SubjectName</h2>
        <div class="sub">Grade management</div>
    </div>
    <a class="btn btn-outline" asp-action="Index">← Back to subjects</a>
</div>

@if (TempData["msg"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;padding:10px 16px;background:var(--color-success-bg,#eafaf1);border:0.5px solid var(--color-success-border,#a9dfbf);border-radius:var(--border-radius-md,8px);color:var(--color-success,#1e8449);font-size:13px;">
        @TempData["msg"]
    </div>
}

@* Period tabs *@
<div style="display:flex;gap:8px;margin-bottom:20px;">
    @foreach (var p in periods)
    {
        <a class="btn @(p == period ? "btn-primary" : "btn-outline")"
           asp-action="Subject" asp-route-id="@Model.Subject.SubjectId" asp-route-period="@p">
            @p
        </a>
    }
</div>

<div style="display:grid;grid-template-columns:1fr 320px;gap:16px;align-items:start;">

    @* LEFT: grade sheet *@
    <div>
        @* Add column form *@
        <div class="panel" style="margin-bottom:16px;">
            <div class="panel-head"><h3>Add column</h3></div>
            <div class="panel-body">
                <form asp-action="AddColumn" method="post" style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="subjectId" value="@Model.Subject.SubjectId" />
                    <div>
                        <label style="font-size:12px;color:var(--color-muted);display:block;margin-bottom:4px;">Type</label>
                        <select name="Type" class="form-control" style="width:130px;">
                            @foreach (var tp in types)
                            {
                                <option value="@tp">@tp</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label style="font-size:12px;color:var(--color-muted);display:block;margin-bottom:4px;">Title</label>
                        <input name="Title" class="form-control" style="width:180px;" placeholder="e.g. Quiz 1" required />
                    </div>
                    <div>
                        <label style="font-size:12px;color:var(--color-muted);display:block;margin-bottom:4px;">Max score</label>
                        <input name="MaxScore" type="number" class="form-control" style="width:100px;" value="100" min="1" max="1000" required />
                    </div>
                    <input type="hidden" name="Period" value="@period" />
                    <button class="btn btn-primary" type="submit">+ Add</button>
                </form>
            </div>
        </div>

        @* Grade table *@
        @if (!Model.Students.Any())
        {
            <div class="panel"><div class="empty">No students enrolled.</div></div>
        }
        else
        {
            <form asp-action="SaveScores" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subjectId" value="@Model.Subject.SubjectId" />
                <input type="hidden" name="period" value="@period" />

                <div class="panel" style="overflow-x:auto;">
                    <table class="table" style="min-width:600px;table-layout:auto;">
                        <thead>
                            <tr>
                                <th style="min-width:160px;">Student</th>
                                @foreach (var tp in types)
                                {
                                    var typeCols = cols.Where(c => c.Type == tp).ToList();
                                    @foreach (var col in typeCols)
                                    {
                                        <th style="min-width:90px;text-align:center;">
                                            <div style="font-size:10px;color:var(--color-muted);font-weight:400;">@col.Type</div>
                                            <div>@col.Title</div>
                                            <div style="font-size:10px;color:var(--color-muted);font-weight:400;">/ @col.MaxScore</div>
                                            <button type="button"
                                                    onclick="deleteColumn(@col.GradeColumnId)"
                                                    style="font-size:10px;color:var(--color-primary);background:none;border:none;cursor:pointer;padding:0;">
                                                ✕ remove
                                            </button>
                                        </th>
                                    }
                                }
                                <th style="text-align:center;min-width:90px;">Period grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                var periodGrade = period == "Midterm"
                                    ? Model.MidtermGrades.GetValueOrDefault(student.StudentId)
                                    : Model.FinalsGrades.GetValueOrDefault(student.StudentId);

                                <tr>
                                    <td>
                                        <div style="font-weight:500;font-size:13px;">@student.FullName</div>
                                        <div style="font-size:11px;color:var(--color-muted);">@student.StudentNumber</div>
                                    </td>
                                    @foreach (var tp in types)
                                    {
                                        var typeCols = cols.Where(c => c.Type == tp).ToList();
                                        @foreach (var col in typeCols)
                                        {
                                            var score = Model.Scores.TryGetValue(student.StudentId, out var sc)
                                                && sc.TryGetValue(col.GradeColumnId, out var sv) ? sv : null;
                                            <td style="text-align:center;padding:4px 6px;">
                                                <input type="number"
                                                       name="scores[@student.StudentId][@col.GradeColumnId]"
                                                       class="form-control"
                                                       style="width:80px;text-align:center;padding:4px 6px;font-size:13px;"
                                                       min="0" max="@col.MaxScore" step="0.01"
                                                       value="@(score.HasValue ? score.Value.ToString("0.##") : "")"
                                                       placeholder="—" />
                                            </td>
                                        }
                                    }
                                    <td style="text-align:center;">
                                        @if (periodGrade.HasValue)
                                        {
                                            var cls = periodGrade.Value <= 3.0m ? "badge-green" : "badge-red";
                                            <span class="badge @cls">@periodGrade.Value.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--color-muted);font-size:12px;">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div style="margin-top:12px;display:flex;justify-content:flex-end;">
                    <button class="btn btn-primary" type="submit">Save grades</button>
                </div>
            </form>

            @* Final grade summary *@
            <div class="panel" style="margin-top:16px;">
                <div class="panel-head"><h3>Final grade summary</h3></div>
                <div class="panel-body" style="padding:0;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th style="text-align:center;">Midterm (@Model.MidtermWeight.MidtermWeight%)</th>
                                <th style="text-align:center;">Finals (@Model.MidtermWeight.FinalsWeight%)</th>
                                <th style="text-align:center;">Final grade</th>
                                <th style="text-align:center;">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                var mg = Model.MidtermGrades.GetValueOrDefault(student.StudentId);
                                var fg = Model.FinalsGrades.GetValueOrDefault(student.StudentId);
                                var final = Model.FinalGrades.GetValueOrDefault(student.StudentId);
                                var passed = final.HasValue && final.Value <= 3.0m;
                                <tr>
                                    <td>
                                        <div style="font-weight:500;">@student.FullName</div>
                                        <div style="font-size:11px;color:var(--color-muted);">@student.StudentNumber</div>
                                    </td>
                                    <td style="text-align:center;">
                                        @(mg.HasValue ? mg.Value.ToString("0.00") : "—")
                                    </td>
                                    <td style="text-align:center;">
                                        @(fg.HasValue ? fg.Value.ToString("0.00") : "—")
                                    </td>
                                    <td style="text-align:center;">
                                        @if (final.HasValue)
                                        {
                                            <strong>@final.Value.ToString("0.00")</strong>
                                        }
                                        else { <span style="color:var(--color-muted);">—</span> }
                                    </td>
                                    <td style="text-align:center;">
                                        @if (final.HasValue)
                                        {
                                            <span class="badge @(passed ? "badge-green" : "badge-red")">
                                                @(passed ? "Passed" : "Failed")
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @* RIGHT: weights panel *@
    <div>
        <div class="panel">
            <div class="panel-head"><h3>@period weights</h3></div>
            <div class="panel-body">
                <form asp-action="SaveWeights" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="subjectId" value="@Model.Subject.SubjectId" />
                    <input type="hidden" name="period" value="@period" />

                    <div style="font-size:12px;color:var(--color-muted);margin-bottom:12px;">
                        Component weights (must total 100%)
                    </div>

                    @foreach (var (label, field, val) in new[]
                    {
                        ("Activities %",  "activityWeight", weight.ActivityWeight),
                        ("Quizzes %",     "quizWeight",     weight.QuizWeight),
                        ("Exams %",       "examWeight",     weight.ExamWeight),
                        ("Projects %",    "projectWeight",  weight.ProjectWeight),
                    })
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                            <label style="font-size:13px;">@label</label>
                            <input type="number" name="@field" class="form-control"
                                   style="width:80px;text-align:center;"
                                   min="0" max="100" step="1" value="@val" />
                        </div>
                    }

                    @if (period == "Midterm")
                    {
                        <div style="border-top:0.5px solid var(--color-border,#e5e5e5);padding-top:12px;margin-top:4px;">
                            <div style="font-size:12px;color:var(--color-muted);margin-bottom:12px;">
                                Period weights for final grade
                            </div>
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                                <label style="font-size:13px;">Midterm %</label>
                                <input type="number" name="midtermWeight" class="form-control"
                                       style="width:80px;text-align:center;"
                                       min="0" max="100" step="1" value="@Model.MidtermWeight.MidtermWeight" />
                            </div>
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                                <label style="font-size:13px;">Finals %</label>
                                <input type="number" name="finalsWeight" class="form-control"
                                       style="width:80px;text-align:center;"
                                       min="0" max="100" step="1" value="@Model.MidtermWeight.FinalsWeight" />
                            </div>
                        </div>
                    }

                    <button class="btn btn-primary" type="submit" style="width:100%;margin-top:8px;">
                        Save weights
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>

@* Delete column form - outside all other forms to avoid nested form issue *@
<form id="deleteColumnForm" asp-action="DeleteColumn" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteColumnId" name="columnId" />
    <input type="hidden" name="subjectId" value="@Model.Subject.SubjectId" />
    <input type="hidden" name="period" value="@period" />
</form>

<script>
function deleteColumn(columnId) {
    if (!confirm('Remove this column?')) return;
    document.getElementById('deleteColumnId').value = columnId;
    document.getElementById('deleteColumnForm').submit();
}
</script>
