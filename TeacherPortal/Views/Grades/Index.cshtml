@model IEnumerable<TeacherPortal.Models.Subject>
@{ ViewData["Title"] = "Grades"; }

<div class="section-head">
    <div>
        <h2>Grades</h2>
        <div class="sub">Select a subject to manage grades</div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="panel">
        <div class="empty">
            <div class="ico">★</div>
            No subjects found.
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
        @foreach (var s in Model)
        {
            <div style="background:var(--color-surface,#fff);border:0.5px solid var(--color-border,#e5e5e5);border-radius:var(--border-radius-md,12px);padding:20px 22px;display:flex;flex-direction:column;gap:14px;box-shadow:0 1px 4px rgba(0,0,0,.04);transition:box-shadow .15s;">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                    <div>
                        <div style="font-size:11px;font-weight:600;letter-spacing:.06em;color:var(--color-primary,#c0392b);text-transform:uppercase;margin-bottom:4px;">@s.SubjectCode</div>
                        <div style="font-size:15px;font-weight:600;color:var(--color-text,#1a1a1a);line-height:1.3;">@s.SubjectName</div>
                    </div>
                    <div style="width:36px;height:36px;border-radius:8px;background:var(--color-primary-bg,#fdf2f2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <span style="font-size:16px;">📋</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(s.Description))
                {
                    <div style="font-size:12px;color:var(--color-muted,#888);line-height:1.5;">@s.Description</div>
                }

                <div style="display:flex;gap:8px;margin-top:auto;">
                    <a asp-action="Subject" asp-route-id="@s.SubjectId" asp-route-period="Midterm"
                       style="flex:1;text-align:center;padding:8px 0;border-radius:6px;font-size:12px;font-weight:600;background:var(--color-primary,#c0392b);color:#fff;text-decoration:none;">
                        Midterm
                    </a>
                    <a asp-action="Subject" asp-route-id="@s.SubjectId" asp-route-period="Finals"
                       style="flex:1;text-align:center;padding:8px 0;border-radius:6px;font-size:12px;font-weight:600;background:transparent;color:var(--color-primary,#c0392b);border:1.5px solid var(--color-primary,#c0392b);text-decoration:none;">
                        Finals
                    </a>
                </div>
            </div>
        }
    </div>
}
