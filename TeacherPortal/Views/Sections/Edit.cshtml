@model TeacherPortal.Models.Section
@{ ViewData["Title"] = "Edit Section"; }

<div class="section-head">
  <div>
    <h2>Edit Section</h2>
    <div class="sub">Update section details and class grouping information.</div>
  </div>
</div>

<div class="form-card section-form-card">
  <form asp-action="Edit" method="post">
    <input type="hidden" asp-for="SectionId" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="profile-form-grid">
      <div class="form-row">
        <label asp-for="SectionName">Section Name</label>
        <input asp-for="SectionName" class="form-control" />
        <span asp-validation-for="SectionName" class="text-danger"></span>
      </div>
      <div class="form-row">
        <label asp-for="YearLevel">Year Level</label>
        <input asp-for="YearLevel" class="form-control" />
        <span asp-validation-for="YearLevel" class="text-danger"></span>
      </div>
    </div>
    <div class="form-row">
      <label asp-for="Description"></label>
      <textarea asp-for="Description" class="form-control" rows="4"></textarea>
      <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary">Save Changes</button>
      <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
  </form>
</div>
