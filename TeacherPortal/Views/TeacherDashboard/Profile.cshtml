@model TeacherProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var initials = string.Join("", (Model.FullName ?? "Teacher")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(x => x[0])).ToUpperInvariant();
}

<div class="section-head profile-head">
  <div>
    <h2>Profile Settings</h2>
    <div class="sub">Manage your teacher account, contact details, and class assignments.</div>
  </div>
  <span class="badge badge-red">Teacher</span>
</div>

@if (TempData["Success"] is string success)
{
  <div class="alert alert-success">@success</div>
}

<div class="profile-layout">
  <aside class="profile-summary">
    <div class="profile-cover"></div>
    <div class="profile-summary-body">
      <div class="profile-avatar">@initials</div>
      <h3>@Model.FullName</h3>
      <p>@Model.Email</p>
      <div class="profile-id">Employee No. @Model.EmployeeNumber</div>
    </div>
    <div class="profile-stats">
      <div><strong>@Model.TotalStudents</strong><span>Students</span></div>
      <div><strong>@Model.TotalSubjects</strong><span>Subjects</span></div>
      <div><strong>@Model.TotalSections</strong><span>Sections</span></div>
    </div>
  </aside>

  <section class="profile-main">
    <div class="panel profile-panel">
      <div class="panel-head">
        <h3>Personal Information</h3>
        <span class="profile-panel-note">Visible in your portal records</span>
      </div>
      <div class="panel-body">
        <form asp-action="Profile" method="post" class="profile-form">
          <div asp-validation-summary="ModelOnly"></div>
          <div class="profile-form-grid">
            <div class="form-row">
              <label asp-for="FullName"></label>
              <input asp-for="FullName" class="form-control" />
              <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-row">
              <label asp-for="Email"></label>
              <input asp-for="Email" class="form-control" />
              <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-row">
              <label asp-for="PhoneNumber"></label>
              <input asp-for="PhoneNumber" class="form-control" placeholder="Optional" />
              <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-row">
              <label>Role</label>
              <input class="form-control" value="@Model.Role" disabled />
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
      </div>
    </div>

    <div class="profile-grid">
      <div class="panel">
        <div class="panel-head"><h3>Account Details</h3></div>
        <div class="panel-body profile-detail-list">
          <div><span>Username</span><strong>@Model.UserName</strong></div>
          <div><span>Email status</span><strong>@(Model.EmailConfirmed ? "Verified" : "Not verified")</strong></div>
          <div><span>Two-factor authentication</span><strong>@(Model.TwoFactorEnabled ? "Enabled" : "Disabled")</strong></div>
          <div><span>Schedules assigned</span><strong>@Model.TotalSchedules</strong></div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><h3>Teaching Load</h3></div>
        <div class="panel-body profile-load-list">
          @if (Model.Subjects.Any())
          {
            @foreach (var subject in Model.Subjects)
            {
              <div class="profile-load-item">
                <div>
                  <strong>@subject.Code</strong>
                  <span>@subject.Name</span>
                </div>
                <small>@(subject.Schedule ?? "No schedule")@(string.IsNullOrWhiteSpace(subject.Room) ? "" : $" - {subject.Room}")</small>
              </div>
            }
          }
          else
          {
            <div class="empty compact-empty">No subjects assigned yet.</div>
          }
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>Handled Sections</h3></div>
      <div class="panel-body profile-section-grid">
        @if (Model.Sections.Any())
        {
          @foreach (var handledSection in Model.Sections)
          {
            <div class="profile-section-item">
              <strong>@handledSection.Name</strong>
              <span>@handledSection.YearLevel</span>
              <small>@handledSection.StudentCount students</small>
            </div>
          }
        }
        else
        {
          <div class="empty compact-empty">No sections assigned yet.</div>
        }
      </div>
    </div>
  </section>
</div>
